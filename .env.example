# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your values.  Never commit `.env`.
# ---------------------------------------------------------------------------

# --- SMTP (how the mail actually gets sent) --------------------------------
# Gmail example (recommended: create an "App Password", NOT your login password
# — https://myaccount.google.com/apppasswords — requires 2-Step Verification):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password

# Outlook / Office365 example:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false

# Any other provider (SendGrid, Mailgun, Zoho, your college server) works too —
# just use the SMTP host/port/user/pass they give you.

# What recipients see in the "From" field.
MAIL_FROM_NAME=Kirtika
MAIL_FROM_EMAIL=you@gmail.com
# Optional: where replies should go if different from the sender.
# MAIL_REPLY_TO=you@gmail.com

# --- Sending behaviour -----------------------------------------------------
# How many emails to send in parallel. Keep low for Gmail (2-3).
SEND_CONCURRENCY=3
# Milliseconds to pause after each email (throttling, avoids provider limits).
SEND_DELAY_MS=400
# How many times to retry a failed recipient before giving up.
SEND_MAX_RETRIES=2

# --- AI content generation (optional) --------------------------------------
# Set ONE of the two keys below to switch on the "Draft it with AI" button.
# Leave both blank and everything else still works — you just write the email
# yourself.

# OpenAI — get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Any model your OpenAI project can access. gpt-4.1-mini is cheaper/faster,
# gpt-5.4 is newer. Run `npm run check` after changing it.
OPENAI_MODEL=gpt-4.1

# Anthropic (Claude) — get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# If you set both keys, pick which one to use: openai | anthropic | auto
AI_PROVIDER=auto

# --- Server ----------------------------------------------------------------
PORT=3210
# Set a value here to require a password on the dashboard (recommended if you
# ever expose this beyond localhost). Leave blank for no login.
DASHBOARD_PASSWORD=
